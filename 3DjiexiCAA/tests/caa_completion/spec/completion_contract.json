    "product_instances.jsonl",
    "relations.jsonl",
    "parameters.jsonl",
    "business_features.jsonl",
    "capabilities.json",
    "capability_matrix.json",
    "diagnostics.json",
    "coverage.json",
    "parser.log",
    "manifest.json"
