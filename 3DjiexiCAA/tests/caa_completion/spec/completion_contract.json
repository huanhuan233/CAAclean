{
  "contract_id": "3DjiexiCAA-caa-pre-python-completion-v1",
  "scope": "CATIA V5R21 CAA/C++ data extraction before Python manufacturing-feature recognition",
  "minimum_schema_generation": 11,
  "forbidden_completion_shortcuts": [
    "geometry_fingerprint_candidate_as_authoritative_mapping",
    "display_name_or_file_name_type_inference",
    "step_import_as_native_feature_fixture",
    "empty_fta_set_as_fta_semantics_complete",
    "fixture_manifest_values_copied_into_parser_output",
    "single_hole_fixture_as_family_completion"
  ],
  "required_artifacts": [
    "features.jsonl",
    "native_features.jsonl",
    "decoder_registry.json",
    "native_feature_results.jsonl",
    "native_feature_result_cells.jsonl",
    "native_feature_topology_links.jsonl",
    "native_topology_bodies.jsonl",
    "native_topology_cells.jsonl",
    "native_topology_wires.jsonl",
    "native_mesh_face_map.jsonl",
