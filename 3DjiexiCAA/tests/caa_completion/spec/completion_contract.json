    "feature_final_topology_history": "complete",
    "native_feature_extraction": "complete",
    "topology_extraction": "complete",
    "native_feature_topology_mapping": "complete",
    "fta_extraction": "complete",
    "fta_topology_mapping": "complete",
    "mesh_face_mapping": "complete",
    "product_structure_extraction": "complete",
    "instance_transform_extraction": "complete",
    "catproduct_instance_extraction": "complete",
    "decoder_registry_export": "complete"
