  "deterministic_artifacts": [
    "features.jsonl", "native_features.jsonl", "decoder_registry.json",
    "native_feature_results.jsonl", "native_feature_result_cells.jsonl",
    "native_feature_topology_links.jsonl", "native_topology_bodies.jsonl",
    "native_topology_cells.jsonl", "native_topology_wires.jsonl",
