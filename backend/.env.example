# Web 后端读取 backend/.env；密钥只写本机 .env，不提交真实值。
APP_HOST=127.0.0.1
APP_PORT=5180
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/postgres
FREECAD_CMD=FreeCADCmd.exe
CAD_WORK_DIR=../cad-work

# CATIA 部署模式：同机调试可用 local_process；Docker/跨主机推荐 http；无 CATIA 时用 disabled。
CATIA_WORKER_MODE=http
CATIA_WORKER_URL=http://127.0.0.1:5182
CATIA_WORKER_TOKEN=
CATIA_WORKER_CONNECT_TIMEOUT=5
CATIA_WORKER_REQUEST_TIMEOUT=120
CATIA_WORKER_POLL_INTERVAL=1
CATIA_WORKER_JOB_TIMEOUT=1800
CATIA_WORKER_MAX_CONCURRENCY=1

# Windows Worker 自身使用；Docker 后端访问宿主机时可将 URL 改为 host.docker.internal。
CAA_RADE_ROOT=
CAA_PREREQ_ROOT=
CATIA_WORKER_SERVER_WORK_DIR=../.runtime/catia-worker
CATIA_WORKER_SERVER_ENABLED=true
